# ── Nodes ────────────────────────────────────────────────────────────────────
# Comma-separated list of Ollama node base URLs.
# When omitted, auto-discovery scans the local network.
# OLLAMA_NODES=http://192.168.1.10:11434,http://192.168.1.11:11434

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Discovery ────────────────────────────────────────────────────────────────
# AUTO_DISCOVER=true
# NETWORK_SCAN_INTERVAL=60000

# ── Routing ──────────────────────────────────────────────────────────────────
# When true, requests for unknown models fall back to auto routing instead of 404.
# ROUTER_FALLBACK_TO_AUTO=false

# ── Inference ────────────────────────────────────────────────────────────────
# Inference request timeout in ms. Set to 0 to disable.
# INFERENCE_TIMEOUT=600000

# ── Persistence ──────────────────────────────────────────────────────────────
# METRICS_FILE=./data/model-metrics.json
# DISABLED_MODELS_FILE=./data/disabled-models.json

# ── Ollama Cloud ─────────────────────────────────────────────────────────────
# Base URL for the Ollama cloud API (default: https://ollama.com).
# OLLAMA_CLOUD_URL=https://ollama.com

# API key for Ollama cloud inference.
# Obtain from: https://ollama.com/settings/keys
# When set, a cloud node is automatically registered in the router.
# OLLAMA_CLOUD_API_KEY=your_api_key_here

# Session cookie for reading cloud usage quota (session % and weekly %).
# Used by the dashboard usage footer and the routing penalty system.
#
# Option A — explicit cookie string (recommended for servers / Docker):
#   Copy the full Cookie header value from browser DevTools after logging
#   into ollama.com. Look for __Secure-next-auth.session-token.
# OLLAMA_CLOUD_SESSION_COOKIE=__Secure-next-auth.session-token=...
#
# Option B — leave unset (macOS / local only):
#   @steipete/sweet-cookie will auto-extract the cookie from Chrome's
#   local keyring. No env var needed on a dev machine with Chrome logged in.
